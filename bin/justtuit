#!/usr/bin/env node
/**
 * justtuit launcher.
 *
 * OpenTUI's native core only runs under Bun (its FFI is not available under
 * Node yet), so this thin Node shim locates Bun and delegates to it. This lets
 * the package work with `npm i -g justtuit` and `npx justtuit` without the
 * user having to manually prefix every invocation with `bun`.
 */
import { spawn, spawnSync } from "node:child_process";
import { accessSync, constants, existsSync } from "node:fs";
import path from "node:path";
import os from "node:os";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const BUN_INSTALL_URL = "https://bun.sh/install";

function isExecutable(file) {
  try {
    accessSync(file, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

function findBun() {
  const candidates = [];

  if (process.env.BUN) candidates.push(process.env.BUN);

  // Common install locations for bun.
  const home = os.homedir();
  candidates.push(
    path.join(home, ".bun", "bin", "bun"),
    path.join(home, ".bun", "bin", "bun.exe"),
    "/usr/local/bin/bun",
    "/opt/homebrew/bin/bun",
  );

  for (const candidate of candidates) {
    if (existsSync(candidate) && isExecutable(candidate)) return candidate;
  }

  // Fall back to whatever is on PATH.
  try {
    const probe = spawnSync("bun", ["--version"], { stdio: "ignore" });
    if (probe.status === 0) return "bun";
  } catch {
    /* ignore */
  }

  return null;
}

const bun = findBun();

if (!bun) {
  console.error("");
  console.error("  justtuit needs Bun to run (OpenTUI's native core requires it).");
  console.error("");
  console.error("  Install Bun with:");
  console.error(`    curl -fsSL ${BUN_INSTALL_URL} | bash`);
  console.error("");
  process.exit(1);
}

// Resolve the app entry relative to this launcher, so it works regardless of
// the caller's current working directory (npm global bin, npx cache, etc.).
const entry = path.join(__dirname, "..", "src", "index.tsx");

const child = spawn(bun, [entry], { stdio: "inherit" });

child.on("error", (err) => {
  console.error(`failed to start justtuit: ${err.message}`);
  process.exit(1);
});

child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }
  process.exit(code == null ? 0 : code);
});
